            {
              "id": "CWE-287",
              "name": "account_takeover",
              "shortDescription": {
                "text": "JWT forgery -> account takeover (kid_path_traversal)"
              },
              "fullDescription": {
                "text": "Pin the signature algorithm, verify signatures on every token, and reject alg=none / key-confusion."
              },
              "properties": {
                "cwe": [
                  "CWE-287",
                  "CWE-347"
                ],
                "owasp": "A07:2021 – Identification and Authentication Failures",
                "mitre_tactic": "TA0006"
              }
            },
            {
              "id": "CWE-639",
              "name": "idor",
              "shortDescription": {
                "text": "BOLA/IDOR: cross-user access to /workshop/api/shop/orders/1"
              },
              "fullDescription": {
                "text": "Enforce object-level authorization (ownership) on every resource identifier, server-side."
              },
              "properties": {
                "cwe": [
                  "CWE-639"
                ],
                "owasp": "A01:2021 – Broken Access Control",
                "mitre_tactic": "TA0009"
              }
            },
            {
              "id": "CWE-94",
              "name": "code_execution",
              "shortDescription": {
                "text": "HIGH · Apache 2.4.49 Path Traversal"
              },
              "fullDescription": {
                "text": "Never eval/exec dynamic content. Replace with safe interpreters (ast.literal_eval, JSON, safe templates)."
              },
              "properties": {
                "cwe": [
                  "CWE-94",
                  "CWE-95"
                ],
                "owasp": "A03:2021 – Injection",
                "mitre_tactic": "TA0002"
              }
            },
            {
              "id": "CWE-89",
              "name": "sql",
              "shortDescription": {
                "text": "MEDIUM · Exposed Admin Panel"
              },
              "fullDescription": {
                "text": "Use parameterized queries / prepared statements; never concatenate untrusted input into SQL."
              },
              "properties": {
                "cwe": [
                  "CWE-89"
                ],
                "owasp": "A03:2021 – Injection",
                "mitre_tactic": "TA0006"
              }
            }
          ]
        }
