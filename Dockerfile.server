# VALEN server image — single-operator, self-hosted.
#
#   docker build -f Dockerfile.server -t valen .
#   docker run --rm -p 127.0.0.1:8000:8000 -v valen-data:/data valen
#
# Serves the SPA (/) and the red-team console (/console). Secure by default:
# binds 0.0.0.0 in the container but the app executes nothing (no --allow-exec)
# and only hits loopback targets (no --allow-host). Pass a token with
# VALEN_TOKEN and --allow-exec for the full toolkit.
#
# The Rust numeric core is optional: it is built when the build has network for
# crates.io; otherwise the image uses the pure-Python fallback (same JSON API).

# ---- stage 1: build the optional Rust numeric core ------------------------
FROM rust:1-slim-bookworm AS core
WORKDIR /src
COPY core ./core
# Best-effort: produce /out/valen-core when possible. If the registry is
# unreachable, /out stays empty and the runtime uses the Python fallback.
RUN mkdir -p /out \
 && (cargo build --release --manifest-path core/Cargo.toml \
     && cp core/target/release/valen-core /out/valen-core) \
    || echo "valen-core build skipped (offline) -> pure-Python fallback"

# ---- stage 2: runtime ------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VALEN_DATA_DIR=/data \
    PYTHONPATH=/app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN pip install --upgrade pip && pip install ".[llm]"
# Drop in the prebuilt core (empty dir if the build was skipped -> fallback).
COPY --from=core /out /app/core/target/release
RUN useradd -m -u 10001 valen && mkdir -p /data && chown -R valen:valen /data
USER valen
VOLUME ["/data"]
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/adapters', timeout=4).status==200 else 1)"
ENTRYPOINT ["valen"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]
